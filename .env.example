# Copy this file to ".env" (which is git-ignored) and replace the placeholders.
# NEVER commit .env and never put keys in settings.toml or in the code.
# A placeholder (anything starting with "your-") or an empty value means
# "not configured": Drivion skips that feature or provider instead of crashing.

# Picovoice Porcupine access key (not used: Drivion uses openWakeWord)
DRIVION_PORCUPINE_ACCESS_KEY=

# AI providers, used as a fallback chain in the order of [llm] providers
# in config/settings.toml. You only need one; more keys = more resilience.
#   Gemini:      https://aistudio.google.com/apikey
#   Groq:        https://console.groq.com/keys
#   OpenRouter:  https://openrouter.ai/keys
DRIVION_GEMINI_API_KEY=your-gemini-api-key-here
DRIVION_GROQ_API_KEY=your-groq-api-key-here
DRIVION_OPENROUTER_API_KEY=your-openrouter-api-key-here
