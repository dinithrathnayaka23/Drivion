# Copy this file to ".env" (which is git-ignored) and fill in real values.
# Never commit .env. Leave a value empty if you don't use that feature yet;
# Drivion will disable the feature instead of crashing.

# Picovoice Porcupine access key (wake word) - https://console.picovoice.ai/
DRIVION_PORCUPINE_ACCESS_KEY=

# API key for the cloud LLM provider selected in config/settings.toml
DRIVION_LLM_API_KEY=
